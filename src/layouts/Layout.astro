---
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/space-grotesk";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Nix TacoSprint 2027 · La Saladita, Mexico",
  description = "A week of Nix hacking, collaboration, and knowledge sharing in La Saladita, Mexico. June 2027. All skill levels welcome.",
} = Astro.props;
const archive = Astro.url.pathname.startsWith("/2026");
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006847" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/assets/villas.jpeg", Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="wordmark" href="/" aria-label="TacoSprint home">
        <img
          class="brand-symbol"
          src="/assets/tacosprint.svg"
          alt=""
          width="48"
          height="40"
        />{" "}
        taco<span>sprint</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#about">The sprint</a>
        <a href="/#location">Location</a>
        <a href="/2026/" aria-current={archive ? "page" : undefined}>
          2026 edition
        </a>
      </nav>
      <a class="button button-small" href="/#sponsors">
        Become a sponsor
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-links">
        <a href="mailto:sponsors@tacosprint.org">Get in touch</a>
        <a
          class="source-link"
          href="https://github.com/OceanSprint/tacosprint.org"
          aria-label="tacosprint.org on GitHub"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .297a12 12 0 0 0-3.793 23.385c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.419-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23a11.52 11.52 0 0 1 6.006 0c2.291-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.119 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.001 12.001 0 0 0 12 .297Z"></path>
          </svg>
          tacosprint.org
        </a>
      </div>
      <p class="copyright">
        © {new Date().getFullYear()} Domen Kozar & Farid Zakaria
      </p>
    </footer>
  </body>
</html>
