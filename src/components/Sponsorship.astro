---
const levels = [
  {
    name: "Individual",
    price: "500",
    perks: ["Your link on the website"],
    value: "Individual (USD 500)",
  },
  {
    name: "Company",
    price: "1,500",
    perks: [
      "Logo on the website & T shirt",
      "Company name on your name tag",
      "1 reserved seat",
    ],
    value: "Company (USD 1,500)",
  },
  {
    name: "Gold",
    price: "4,000",
    perks: [
      "Everything in Company",
      "Large logo & 2 reserved seats",
      "Dinner shoutout & SWAG",
      "Thank you note in final report",
      "Simple procurement process",
    ],
    value: "Gold (USD 4,000)",
  },
  {
    name: "Diamond",
    price: "8,000",
    perks: [
      "Everything in Gold",
      "Prominent logo & keynote",
      "Custom SWAG",
      "Complex procurement supported",
    ],
    value: "Diamond (USD 8,000)",
  },
];
---

<section class="sponsorship section" id="sponsors">
  <div class="container">
    <div class="tier-grid">
      {levels.map((level) => (
        <article class:list={["tier", { selected: level.name === "Gold" }]}>
          <div class="tier-top">
            <h3>{level.name}</h3>
          </div>
          <p class="tier-price">
            ${level.price}
            <small> USD</small>
          </p>
          <ul>
            {level.perks.map((perk) => (
              <li>{perk}</li>
            ))}
          </ul>
          <a
            class="tier-link"
            href="#sponsorship-inquiry"
            data-level={level.value}
            aria-current={level.name === "Gold" ? "true" : undefined}
          >
            Choose {level.name.toLowerCase()}
          </a>
        </article>
      ))}
    </div>
    <div class="inquiry-grid" id="sponsorship-inquiry">
      <div>
        <h2>Sponsorship inquiries.</h2>
        <p>
          Sponsorship pays for accommodation, breakfast, lunch, T shirts, and
          some activities, giving attendees more time to work on Nix.
        </p>
        <p>
          Choose a tier or contact us to discuss other ways to support the
          sprint.
        </p>
        <a class="text-link" href="mailto:sponsors@tacosprint.org">
          sponsors@tacosprint.org
        </a>
        <p class="form-note" id="sponsorship-help">
          This form prepares a draft in your email app. Review and send it there
          to complete your inquiry.
        </p>
      </div>
      <form
        id="sponsorship-form"
        aria-label="Sponsorship inquiry"
        aria-describedby="sponsorship-help"
        hidden
      >
        <div class="form-grid">
          <div>
            <label for="sponsor-name">
              Your name <span>(required)</span>
            </label>
            <input
              id="sponsor-name"
              name="name"
              autocomplete="name"
              maxlength="150"
              placeholder="Alex Smith"
              required
            />
          </div>
          <div>
            <label for="sponsor-email">
              Email address <span>(required)</span>
            </label>
            <input
              id="sponsor-email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              placeholder="alex@company.com"
              required
            />
          </div>
          <div>
            <label for="sponsor-company">Company or organization</label>
            <input
              id="sponsor-company"
              name="company"
              autocomplete="organization"
              maxlength="200"
              placeholder="Your organization"
            />
          </div>
          <div>
            <label for="sponsor-level">Sponsorship level</label>
            <select id="sponsor-level" name="level">
              <option value="Let's discuss">Let's discuss</option>
              {levels.map((level) => (
                <option value={level.value} selected={level.name === "Gold"}>
                  {level.value}
                </option>
              ))}
            </select>
          </div>
        </div>
        <label for="sponsor-message">
          How would you like to help? <span>(required)</span>
        </label>
        <textarea
          id="sponsor-message"
          name="message"
          rows="4"
          maxlength="2000"
          placeholder="Your sponsorship plans or questions"
          required
        ></textarea>
        <button class="button" type="submit">
          Prepare sponsorship email
        </button>
        <p id="sponsorship-status" class="form-note" role="status"></p>
      </form>
      <noscript>
        <p>
          Please email
          <a href="mailto:sponsors@tacosprint.org?subject=TacoSprint%202027%20sponsorship">
            sponsors@tacosprint.org
          </a>
          to discuss sponsorship.
        </p>
      </noscript>
    </div>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>("#sponsorship-form");
  if (form) {
    form.hidden = false;
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const fields = new FormData(form);
      const body = [
        "Hi Domen and Farid,",
        "",
        "I'd like to support Nix TacoSprint in June 2027.",
        "",
        `Name: ${fields.get("name")}`,
        `Email: ${fields.get("email")}`,
        `Company or organization: ${fields.get("company") || "N/A"}`,
        `Sponsorship level: ${fields.get("level")}`,
        "",
        fields.get("message"),
      ].join("\r\n");
      window.location.href = `mailto:sponsors@tacosprint.org?subject=${encodeURIComponent("Nix TacoSprint 2027 sponsorship inquiry")}&body=${encodeURIComponent(body)}`;
      const status = document.querySelector("#sponsorship-status");
      if (status)
        status.textContent =
          "Your inquiry has not been sent yet. Send the draft from your email app. If no draft opens, email sponsors@tacosprint.org directly.";
    });
  }
  const select = document.querySelector<HTMLSelectElement>("#sponsor-level");
  const tierLinks =
    document.querySelectorAll<HTMLAnchorElement>("[data-level]");
  const updateSelectedTier = () => {
    tierLinks.forEach((link) => {
      const selected = link.dataset.level === select?.value;
      link.closest(".tier")?.classList.toggle("selected", selected);
      if (selected) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });
  };
  if (select) {
    select.addEventListener("change", updateSelectedTier);
    updateSelectedTier();
    tierLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (link.dataset.level) {
          select.value = link.dataset.level;
          updateSelectedTier();
        }
      });
    });
  }
</script>
