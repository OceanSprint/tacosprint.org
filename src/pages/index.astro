---
import Layout from "../layouts/Layout.astro";
import Sponsorship from "../components/Sponsorship.astro";
import SprintPhoto from "../components/SprintPhoto.astro";
---

<Layout>
  <section class="hero container">
    <div class="hero-content">
      <h1>
        A week of <br class="hero-title-break" />
        Nix hacking.
        <br />
        <span class="accent">In Mexico.</span>
      </h1>
      <p class="hero-description">
        Work on Nix projects, exchange ideas, and share meals with other
        contributors on Mexico’s Pacific coast.
      </p>
      <p class="hero-welcome">All skill levels welcome.</p>
    </div>
    <div class="hero-photos">
      <figure class="hero-venue">
        <div class="hero-image">
          <img
            src="/assets/villas.jpeg"
            alt="Two villas between the palm trees and the Pacific coast at La Saladita"
            width="1280"
            height="578"
            fetchpriority="high"
          />
        </div>
        <figcaption>June 2027, La Saladita Mexico</figcaption>
      </figure>
      <SprintPhoto compact />
    </div>
  </section>
  <section class="section container about-grid" id="about">
    <div>
      <h2>A sprint for 16 Nix developers.</h2>
    </div>
    <div class="about-copy">
      <p>
        Spend a week working on Nix projects, sharing knowledge, and discussing
        ideas in person. Topics are chosen based on attendees’ interests.
      </p>
      <p>
        New and experienced Nix users are welcome. The small group leaves time
        to discuss projects, ask questions, and work alongside other
        contributors.
      </p>
      <a class="text-link" href="/2026/#report">
        Read the 2026 report
      </a>
    </div>
  </section>
  <section class="place-section section" id="location">
    <div class="container place-grid">
      <div class="place-heading">
        <h2>Location.</h2>
        <img
          class="section-photo"
          src="/assets/2026/sprint-food.webp"
          alt="A plate of fried eggs with tortilla chips, salsa, and crumbled cheese"
          width="1200"
          height="1600"
          loading="lazy"
          decoding="async"
        />
        <p>La Saladita, Guerrero, on Mexico’s Pacific coast.</p>
        <a
          class="text-link"
          href="https://www.google.com/maps/place/La+Saladita,+Gro.,+Mexico"
        >
          View on Google Maps
        </a>
      </div>
      <div class="place-details">
        <article>
          <div>
            <h3>Accommodation</h3>
            <p>
              We’re planning two beachfront villas, surrounded by palms and
              steps from the sand. Accommodation is covered by the sprint
              budget. Final villas to be confirmed.
            </p>
          </div>
        </article>
        <article>
          <div>
            <h3>Food</h3>
            <p>
              Sponsored breakfast and lunch, with tacos, fresh seafood, and
              aguas frescas on the menu. Explore local palapas and taco stands
              for dinner.
            </p>
            <p class="small-copy">
              Partners are welcome. Their food and drinks are not covered.
            </p>
          </div>
        </article>
        <article>
          <div>
            <h3>Nearby activities</h3>
            <p>
              Surf the famous left point break, swim, hike through the jungle,
              or explore local markets. There’s yoga, cooking, and nearby
              Troncones and Zihuatanejo, too.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="section container practical-grid" id="registration">
    <div class="practical-heading">
      <h2>
        Dates, travel
        <br />
        and registration.
      </h2>
      <img
        class="section-photo"
        src="/assets/2026/beach-steps.webp"
        alt="Stone steps through the villa garden leading down to the beach and Pacific Ocean"
        width="1200"
        height="1600"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="faq-list">
      <details open>
        <summary>
          When can I apply?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Applications for the June 2027 sprint will open soon. Exact dates, the
          application form, and the deadline will be announced here once
          confirmed.
        </p>
      </details>
      <details>
        <summary>
          How do I get there?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Fly into Ixtapa/Zihuatanejo International Airport (ZIH). Connections
          through Mexico City (MEX) are an option. La Saladita is approximately
          an hour north by car. Arrange a transfer, taxi, or rental car for the
          final stretch.
        </p>
      </details>
      <details>
        <summary>
          What will we work on?<span aria-hidden="true">+</span>
        </summary>
        <p>
          We’ll shape the sprint topics around attendees’ interests after
          registration closes. Bring the Nix projects, questions, and ideas
          you’d like to explore.
        </p>
      </details>
      <details>
        <summary>
          What’s covered?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Accommodation, breakfast, and lunch are covered by the sprint budget.
          Plan for your own travel, dinners, and any additional activities.
          Partners are welcome, but their food and drinks are not covered.
        </p>
      </details>
      <details>
        <summary>
          Do I need to be a Nix expert?<span aria-hidden="true">+</span>
        </summary>
        <p>No. New and experienced Nix users are welcome.</p>
      </details>
    </div>
  </section>
  <section class="report-row" aria-labelledby="report-title">
    <div class="container place-grid">
      <div class="place-heading">
        <h2 id="report-title">2026 report.</h2>
      </div>
      <div class="place-details">
        <p>What nine contributors worked on in a week.</p>
        <a
          class="text-link"
          href="https://fzakaria.com/assets/pdfs/Attention_Nix_and_Tacos_is_All_You_Need.pdf"
        >
          Read the report (PDF)
        </a>
      </div>
    </div>
  </section>
  <Sponsorship />
  <section class="section container organizers">
    <div>
      <h2>Organizers.</h2>
    </div>
    <a class="organizer" href="https://github.com/domenkozar">
      <img
        src="https://github.com/domenkozar.png?size=160"
        alt=""
        width="80"
        height="80"
        loading="lazy"
      />
      <div>
        <h3>Domen Kozar</h3>
        <p>Nix contributor. Creator of devenv and Cachix.</p>
        <span class="handle">@domenkozar</span>
      </div>
    </a>
    <a class="organizer" href="https://github.com/fzakaria">
      <img
        src="https://github.com/fzakaria.png?size=160"
        alt=""
        width="80"
        height="80"
        loading="lazy"
      />
      <div>
        <h3>Farid Zakaria</h3>
        <p>Build systems and Nix enthusiast.</p>
        <span class="handle">@fzakaria</span>
      </div>
    </a>
  </section>
</Layout>
