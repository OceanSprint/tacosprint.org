---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Sponsorship from "../components/Sponsorship.astro";
import SprintPhoto from "../components/SprintPhoto.astro";
---

<Layout>
  <section class="hero container">
    <div class="hero-topline">
      <p class="eyebrow">
        <span class="status-dot"></span> NIX TACOSPRINT / THE 2027 EDITION
      </p>
      <span class="hero-coordinate">
        LA SALADITA, MÉXICO <span aria-hidden="true">↙</span>
      </span>
    </div>
    <div class="hero-content">
      <div class="hero-title">
        <h1>
          A week of
          <br />
          Nix hacking.
          <br />
          <span class="accent">In Mexico.</span>
        </h1>
      </div>
      <div class="hero-aside">
        <div class="sun-mark" aria-hidden="true">
          ✳
        </div>
        <p>
          Around 16 developers.
          <br />
          All skill levels welcome.
        </p>
        <p class="hero-description">
          Work on Nix projects, exchange ideas, and share meals with other
          contributors on Mexico’s Pacific coast.
        </p>
        <a href="#about" class="hero-discover">
          About the sprint <span aria-hidden="true">↙</span>
        </a>
      </div>
    </div>
    <div class="hero-bottom">
      <div class="hero-meta">
        <span>
          <Icon name="calendar" /> JUNE 2027
        </span>
        <span>
          <Icon name="pin" /> LA SALADITA, MEXICO
        </span>
        <span class="hero-meta-people">~16 NIX DEVELOPERS</span>
      </div>
      <a class="hero-cta" href="#registration">
        Applications opening soon <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="hero-image">
      <img
        src="/assets/villas.jpeg"
        alt="Two villas between the palm trees and the Pacific coast at La Saladita"
        width="1280"
        height="578"
        fetchpriority="high"
      />
      <div class="image-caption">
        <span>
          <span class="status-dot"></span> BEACHFRONT VILLAS / VENUE TO BE
          CONFIRMED
        </span>
        <span>THE PACIFIC COAST, MEXICO ↗</span>
      </div>
      <div class="photo-stamp" aria-hidden="true">
        <span>LA SALADITA</span>
        <Icon name="sun" />
        <span>JUNE 2027</span>
      </div>
    </div>
  </section>
  <div class="ticker" aria-label="Sprint details">
    <div>
      <span>NIX</span>
      <span class="ticker-star">✳</span>
      <span>COLLABORATION</span>
      <span class="ticker-star">✳</span>
      <span>LA SALADITA</span>
      <span class="ticker-star">✳</span>
      <span>OPEN SOURCE</span>
      <span class="ticker-star">✳</span>
      <span>JUNE 2027</span>
      <span class="ticker-star">✳</span>
    </div>
  </div>
  <section class="section container about-grid" id="about">
    <div>
      <p class="eyebrow">01 / About the sprint</p>
      <h2>
        A sprint for
        <br />
        Nix developers.
      </h2>
    </div>
    <div class="about-copy">
      <p class="large-copy">A week to work together, in person.</p>
      <p>
        TacoSprint brings around 16 Nix developers together for focused hacking,
        collaboration, and knowledge sharing. Topics are chosen based on
        attendees’ interests.
      </p>
      <p>
        New and experienced Nix users are welcome. The small group leaves time
        to discuss projects, ask questions, and work alongside other
        contributors.
      </p>
      <a class="text-link" href="/2026/">
        2026 participants and sponsors <Icon name="arrow" />
      </a>
    </div>
    <SprintPhoto />
    <div class="sprint-pillars">
      <div>
        <Icon name="code" />
        <h3>Nix projects</h3>
        <p>
          Work on your projects and collaborate with other attendees. Sprint
          topics will be decided after registration closes.
        </p>
      </div>
      <div>
        <Icon name="wave" />
        <h3>Surfing and activities</h3>
        <p>
          La Saladita has a well-known surf break. Swimming, hiking, and visits
          to nearby towns are also options outside sprint hours.
        </p>
      </div>
      <div>
        <Icon name="sun" />
        <h3>Shared meals</h3>
        <p>
          Breakfast and lunch are covered by sponsors. In the evenings, there
          are local restaurants, palapas, and taco stands nearby.
        </p>
      </div>
    </div>
  </section>
  <section class="place-section section" id="location">
    <div class="container place-grid">
      <div class="place-heading">
        <p class="eyebrow">02 / Location</p>
        <h2>
          La Saladita,
          <br />
          Guerrero.
        </h2>
        <p>
          A surf town on Mexico’s Pacific coast, approximately an hour north of
          Ixtapa/Zihuatanejo International Airport.
        </p>
        <a
          class="text-link"
          href="https://www.google.com/maps/place/La+Saladita,+Gro.,+Mexico"
        >
          View on Google Maps <Icon name="arrow" />
        </a>
        <div class="location-label">
          <Icon name="pin" />
          <span>
            LA SALADITA
            <br />
            <small>GUERRERO, MÉXICO</small>
          </span>
        </div>
      </div>
      <div class="place-details">
        <article>
          <span class="detail-number">01</span>
          <div>
            <h3>Accommodation</h3>
            <p>
              We’re planning two beachfront villas, surrounded by palms and
              steps from the sand. Accommodation is covered by the sprint
              budget. Final villas to be confirmed.
            </p>
          </div>
        </article>
        <article>
          <span class="detail-number">02</span>
          <div>
            <h3>Food</h3>
            <p>
              Sponsored breakfast and lunch, with tacos, fresh seafood, and
              aguas frescas on the menu. Explore local palapas and taco stands
              for dinner.
            </p>
            <p class="small-copy">
              Partners are welcome. Their food and drinks are not covered.
            </p>
          </div>
        </article>
        <article>
          <span class="detail-number">03</span>
          <div>
            <h3>Nearby activities</h3>
            <p>
              Surf the famous left point break, swim, hike through the jungle,
              or explore local markets. There’s yoga, cooking, and nearby
              Troncones and Zihuatanejo, too.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="section container practical-grid" id="registration">
    <div>
      <p class="eyebrow">03 / Practical information</p>
      <h2>
        Dates, travel
        <br />
        and registration.
      </h2>
      <a class="button" href="#sponsors">
        Become a sponsor <Icon name="arrow" />
      </a>
    </div>
    <div class="faq-list">
      <details open>
        <summary>
          When can I apply?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Applications for the June 2027 sprint will open soon. Exact dates, the
          application form, and the deadline will be announced here once
          confirmed.
        </p>
      </details>
      <details>
        <summary>
          How do I get there?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Fly into Ixtapa/Zihuatanejo International Airport (ZIH). Connections
          through Mexico City (MEX) are an option. La Saladita is approximately
          an hour north by car. Arrange a transfer, taxi, or rental car for the
          final stretch.
        </p>
      </details>
      <details>
        <summary>
          What will we work on?<span aria-hidden="true">+</span>
        </summary>
        <p>
          We’ll shape the sprint topics around attendees’ interests after
          registration closes. Bring the Nix projects, questions, and ideas
          you’d like to explore.
        </p>
      </details>
      <details>
        <summary>
          What’s covered?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Accommodation, breakfast, and lunch are covered by the sprint budget.
          Plan for your own travel, dinners, and any additional activities.
          Partners are welcome, but their food and drinks are not covered.
        </p>
      </details>
      <details>
        <summary>
          Do I need to be a Nix expert?<span aria-hidden="true">+</span>
        </summary>
        <p>No. New and experienced Nix users are welcome.</p>
      </details>
    </div>
  </section>
  <Sponsorship />
  <section class="section container organizers">
    <div>
      <p class="eyebrow">Organizers</p>
      <h2>Domen & Farid.</h2>
    </div>
    <a class="organizer" href="https://github.com/domenkozar">
      <img
        src="https://github.com/domenkozar.png?size=160"
        alt=""
        width="80"
        height="80"
        loading="lazy"
      />
      <div>
        <h3>
          Domen Kozar <span>↗</span>
        </h3>
        <p>Nix contributor. Creator of devenv and Cachix.</p>
        <span class="handle">@domenkozar</span>
      </div>
    </a>
    <a class="organizer" href="https://github.com/fzakaria">
      <img
        src="https://github.com/fzakaria.png?size=160"
        alt=""
        width="80"
        height="80"
        loading="lazy"
      />
      <div>
        <h3>
          Farid Zakaria <span>↗</span>
        </h3>
        <p>Build systems and Nix enthusiast.</p>
        <span class="handle">@fzakaria</span>
      </div>
    </a>
  </section>
</Layout>
